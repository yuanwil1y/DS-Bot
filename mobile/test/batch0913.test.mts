import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import assert from 'node:assert/strict';
const walk = (d: string): string[] => readdirSync(d).flatMap((f) => { const p = join(d, f); return statSync(p).isDirectory() ? walk(p) : /\.tsx?$/.test(f) ? [p] : []; });
const files = [...walk('src'), 'App.tsx'];
const all = files.map((f) => readFileSync(f, 'utf8')).join('\n');
const ft = readFileSync('src/featureTest.tsx', 'utf8');
const used = new Set([...ft.matchAll(/act\('([\w.]+)'/g), ...readFileSync('App.tsx', 'utf8').matchAll(/act\('([\w.]+)'/g)].map((m) => m[1]));
const reg = new Set<string>();
for (const m of all.matchAll(/useFT\(([^,]+),/g)) for (const q of m[1].matchAll(/'([\w.]+)'/g)) reg.add(q[1]);
const missing = [...used].filter((n) => !reg.has(n));
assert.deepEqual(missing, [], 'unregistered actions: ' + missing.join(','));
assert.ok(used.size > 30, 'runner uses many actions: ' + used.size);
assert.match(readFileSync('src/screens/SettingsSheet.tsx', 'utf8'), /功能自测（测试用）/);
assert.match(readFileSync('App.tsx', 'utf8'), /<FeatureTestRunner/);
for (const f of ['Menu', 'MessageTools', 'ExchangeSheet', 'ui']) assert.match(readFileSync(`src/components/${f}.tsx`, 'utf8'), /<FTLabel/, f);
assert.doesNotMatch(ft.slice(ft.indexOf('---- The walkthrough')), /\b(fetch|request|api)\s*[.(]/, 'walkthrough never calls the server');
console.log('batch0913 ok', used.size, 'actions');
